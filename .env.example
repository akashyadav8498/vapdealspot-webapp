# ==============================================================================
# VAPE DEAL SPOT — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Application: vapedealspot-webapp
#
# INSTRUCTIONS:
# Copy this file to your deployment environment and populate actual values.
# NEVER commit real credentials, passwords, or production secrets to git.
# ==============================================================================

# --- Active Environment Profile ---
# Must be exactly one of: dev, staging, prod
SPRING_PROFILES_ACTIVE=dev

# --- Server Configuration ---
PORT=8080
APP_ORIGIN=http://localhost:8080

# --- Database Configuration ---
# DEV: Local database defaults to localhost:3306 / vapedealspot
# STAGING: Dedicated staging host / vapedealspot_staging (MANDATORY)
# PROD: Dedicated production host / vapedealspot_prod (MANDATORY)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vapedealspot
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# --- Session & Security ---
# Session duration in Spring format (e.g., 7d, 24h)
SESSION_TIMEOUT=7d

# --- Logging Level ---
# dev: DEBUG | staging: INFO | prod: WARN
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

